# Example 05:

# In this query, we're asking for pairs of proteins that are associated, indicating that the two proteins are connected
# in some way. Associations are symmetric, so comparing the two IDs returns each pair once rather than in both orders:

match
let $p1, $p2 in protein_associations();
$p1 has uniprot-id $p1-id;
$p2 has uniprot-id $p2-id;
$p1-id < $p2-id;
fetch { "protein-1": $p1-id, "protein-2": $p2-id };

# We get four results back, two of them sharing one of the associated proteins. They come from the following function:
#
# fun protein_associations() -> { protein, protein }:
# match
#     {
#         let $p1, $p2 in protein_interactions();
#     } or {
#         pathway-participation (participating-protein: $p1, participated-pathway: $path);
#         pathway-participation (participating-protein: $p2, participated-pathway: $path);
#     };
#     not { $p1 is $p2; };
# select $p1, $p2;
# distinct;
# return { $p1, $p2 };
#
# The first branch of the disjunction covers the association between proteins O60240 and Q8WTS1, which directly
# interact:

match
protein-protein-interaction (interacting-protein: $p1, interacting-protein: $p2);
$p1 has uniprot-id "O60240";
$p2 has uniprot-id "Q8WTS1";
fetch { "protein-1": "O60240", "protein-2": "Q8WTS1" };

# The second branch covers the association between proteins A0M8Q6 and A1L4H1, which both participate in the same
# pathways:

match
$p1 isa protein, has uniprot-id "A0M8Q6";
$p2 isa protein, has uniprot-id "A1L4H1";
pathway-participation (participating-protein: $p1, participated-pathway: $path);
pathway-participation (participating-protein: $p2, participated-pathway: $path);
$path has name $n;
fetch { "pathway": $n };

# Here we see another of TypeDB's most powerful features: a disjunction inside a function lets two different conditions
# lead to the same conclusion. When combined with function composition, this can encode a very large number of cases
# that lead to a high-level conclusion, without specifying every combination individually.

