# Example 02:

# Now let's see which gene encodes for protein Q9NPB9:

match
let $g, $p in protein_encodings();
$p has id "Q9NPB9";
$g has primary-gene-symbol $symbol;
fetch { "gene": $symbol };

# We get the gene ACKR4. No protein-encoding data exists in the database. The protein_encodings function derives it
# from stored data each time we query it:
#
# fun protein_encodings() -> { gene, protein }:
# match
#     transcription (transcribed-gene: $g, synthesised-transcript: $t);
#     translation (translated-transcript: $t, synthesised-protein: $p);
# select $g, $p;
# distinct;
# return { $g, $p };
#
# To see how a result was derived, we can query the function's body directly and return the intermediate concepts. This
# query shows the transcript that links the gene to the protein:

match
$p isa protein, has id "Q9NPB9";
transcription (transcribed-gene: $g, synthesised-transcript: $t);
translation (translated-transcript: $t, synthesised-protein: $p);
$g has primary-gene-symbol $symbol;
$t has ensembl-transcript-id $transcript;
fetch { "gene": $symbol, "transcript": $transcript };

