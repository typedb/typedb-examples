# Example 03:

# In this query, we ask for the names of the tissues in which the gene LAP3 is expressed:

match
let $t, $g in tissue_expressions();
$g has id "LAP3";
$t has name $n;
fetch { "tissue": $n };

# We get three tissues, derived by the following function:
#
# fun tissue_expressions() -> { tissue, gene }:
# match
#     tissue-composition (composed-tissue: $t, composing-cell: $c);
#     cell-expression (expressing-cell: $c, expressed-gene: $g);
# select $t, $g;
# distinct;
# return { $t, $g };
#
# The function joins tissue-composition and cell-expression relations through a shared cell, and returns each tissue and
# gene pair once. Gene LAP3 is expressed in multiple cell types within the kidney, but the kidney still appears only
# once in the results. Selecting $t and $g before distinct removes the cell from the comparison.

